# Copy to .env and adjust. Every key here is also a plain environment variable.

# ---- application --------------------------------------------------------
ENVIRONMENT=dev
API_PREFIX=/api/v1

# ---- storage ------------------------------------------------------------
# Works unchanged with a local mongod or an Atlas cluster:
#   mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=reco
# true  -> start even if MongoDB is unreachable, using an in-process store
# false -> fail fast instead
ALLOW_MEMORY_FALLBACK=true
MONGO_CONNECT_TIMEOUT_MS=1500

# ---- synthetic dataset --------------------------------------------------
N_USERS=1500
N_PRODUCTS=800
N_EVENTS=120000
RANDOM_SEED=42

# ---- modelling ----------------------------------------------------------
SVD_FACTORS=64
KNN_TOP_K=50
CONTENT_TOP_K=100
RECENCY_HALFLIFE_DAYS=30

# ---- evaluation ---------------------------------------------------------
# Positive events held out per user; the older half becomes validation.
EVAL_HOLDOUT_PER_USER=5
TUNING_VAL_SIZE=2
TUNING_MAX_USERS=300
# Trade catalogue reach against accuracy when choosing fusion weights.
# 0 optimises NDCG only, which always zeroes the content weight.
TUNING_COVERAGE_WEIGHT=0.05

# ---- serving ------------------------------------------------------------
DEFAULT_TOP_K=10
MAX_TOP_K=100
MODEL_CACHE_TTL_SECONDS=60
